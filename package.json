{
  "name": "portfolio",
  "version": "1.0.0",
  "description": "Portfolio moderno com Tailwind CSS e JavaScript modularizado",
  "main": "index.html",
  "scripts": {
    "build:css": "npx @tailwindcss/cli -i ./assets/css/input.css -o ./assets/css/main.css --config ./tailwind.config.js --minify",
    "watch:css": "npx @tailwindcss/cli -i ./assets/css/input.css -o ./assets/css/main.css --config ./tailwind.config.js --watch",
    "dev": "python3 -m http.server 5500",
    "build": "npm run build:css && echo '✅ Build concluído!'",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": ["portfolio", "tailwind", "javascript"],
  "author": "Valney Maia",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.2",
    "tailwindcss": "^4.2.2"
  }
}
